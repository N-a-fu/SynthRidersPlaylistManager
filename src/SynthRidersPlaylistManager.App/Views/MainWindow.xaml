<Window x:Class="SynthRidersPlaylistManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SynthRidersPlaylistManager.App.Views"
        Title="{DynamicResource App.Title}" Icon="/Assets/AppIcon.ico" Width="1580" Height="920" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Brush.Background}">
        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#171A1F" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,1" Margin="0,0,3,0">
                <Grid Margin="16,9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource App.Title}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}" Margin="0,0,7,0"/><TextBlock Text="{Binding InstallSummary}" Foreground="{StaticResource Brush.TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="310"/></StackPanel></Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#20252B" CornerRadius="5" Padding="9,5" Margin="0,0,5,0"><StackPanel><TextBlock Text="Library" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding LibraryCount}" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#20252B" CornerRadius="5" Padding="9,5" Margin="0,0,5,0"><StackPanel><TextBlock Text="Favorites" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding FavoriteCount}" Foreground="{StaticResource Brush.Warning}" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#20252B" CornerRadius="5" Padding="9,5"><StackPanel><TextBlock Text="Playlists" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding PlaylistCount}" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Action.LanguageToggle}" Command="{Binding ToggleLanguageCommand}" Padding="9,6" ToolTip="{DynamicResource Action.LanguageTooltip}"/><Button Grid.Column="3" Content="{DynamicResource Action.Rescan}" Command="{Binding RescanCommand}" Padding="12,6"/><Button Grid.Column="5" Content="{DynamicResource Action.Settings}" Command="{Binding OpenSettingsCommand}" Background="{StaticResource Brush.AccentDark}" Padding="12,6"/>
                    </Grid>
                </Grid>
            </Border>
            <views:SelectedSongMiniPlayerView Grid.Column="1" Margin="3,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="430"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
            <views:CollectionBrowserView DataContext="{Binding PaneA}"/>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#37323F" ShowsPreview="True"/>
            <views:CollectionBrowserView Grid.Column="2" DataContext="{Binding PaneB}"/>
        </Grid>
        <Border Grid.Row="2" Background="#171A1F" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/></Grid></Border>

        <Grid Grid.RowSpan="5" Panel.ZIndex="20" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#B0000000"/>
            <Border Width="610" HorizontalAlignment="Right" Background="#25232B" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0" Padding="25">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><TextBlock Text="{DynamicResource Settings.Title}" FontSize="24" FontWeight="SemiBold"/><Button Content="✕" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" Width="38"/></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Data Locations / Real Library — Read-only" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Settings.PathDetectionHelp}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <Button Content="{DynamicResource Settings.Rescan}" Command="{Binding RescanCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding EnvironmentLocations}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#302D38" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusDisplay}" Foreground="{StaticResource Brush.Warning}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding SourceDisplay}" Foreground="{StaticResource Brush.TextMuted}"/></StackPanel></StackPanel>
                                        <Button Grid.Column="1" Content="{DynamicResource Settings.Browse}" Command="{Binding DataContext.BrowseLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5"/>
                                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PathDisplay, Mode=OneWay}" IsReadOnly="True" Margin="0,7,0,5" FontSize="10"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" FontSize="10"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="{DynamicResource Settings.Volume}" Style="{StaticResource SectionLabel}"/><Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="{DynamicResource Settings.Mute}" IsChecked="{Binding IsMuted}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="{DynamicResource Settings.Close}" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" Margin="0,14,0,0" Background="{StaticResource Brush.AccentDark}" MinWidth="96"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
