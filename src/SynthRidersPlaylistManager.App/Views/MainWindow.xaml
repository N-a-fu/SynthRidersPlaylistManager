<Window x:Class="SynthRidersPlaylistManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SynthRidersPlaylistManager.App.Views"
        Title="{DynamicResource App.Title}" Width="1580" Height="920" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Brush.Background}">
        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#171A1F" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,1" Margin="0,0,3,0">
                <Grid Margin="16,9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource App.Title}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}" Margin="0,0,7,0"/><TextBlock Text="{Binding InstallSummary}" Foreground="{StaticResource Brush.TextMuted}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="310"/></StackPanel></Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#20252B" CornerRadius="5" Padding="9,5" Margin="0,0,5,0"><StackPanel><TextBlock Text="VERSION" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding GameVersion}" FontWeight="SemiBold" FontSize="10"/></StackPanel></Border><Border Background="#20252B" CornerRadius="5" Padding="9,5" Margin="0,0,5,0"><StackPanel><TextBlock Text="Library" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding LibraryCount}" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#20252B" CornerRadius="5" Padding="9,5" Margin="0,0,5,0"><StackPanel><TextBlock Text="Favorites" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding FavoriteCount}" Foreground="{StaticResource Brush.Warning}" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#20252B" CornerRadius="5" Padding="9,5"><StackPanel><TextBlock Text="Playlists" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/><TextBlock Text="{Binding PlaylistCount}" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
                        <Button Grid.Column="1" Content="日本語 / EN" Padding="9,6" IsEnabled="False" ToolTip="言語切り替えは今後のLocalization対応で有効になります"/><Button Grid.Column="3" Content="{DynamicResource Action.Rescan}" Command="{Binding RescanCommand}" Padding="12,6"/><Button Grid.Column="5" Content="{DynamicResource Action.Settings}" Command="{Binding OpenSettingsCommand}" Background="{StaticResource Brush.AccentDark}" Padding="12,6"/>
                    </Grid>
                </Grid>
            </Border>
            <views:SelectedSongMiniPlayerView Grid.Column="1" Margin="3,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="430"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="430"/></Grid.ColumnDefinitions>
            <views:CollectionBrowserView DataContext="{Binding PaneA}"/>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#37323F" ShowsPreview="True"/>
            <views:CollectionBrowserView Grid.Column="2" DataContext="{Binding PaneB}"/>
        </Grid>
        <Border Grid.Row="2" Background="#171A1F" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ChangeStateDisplay}" Foreground="{StaticResource Brush.Warning}" FontSize="10"/><Button Grid.Column="3" Content="{Binding GameStateDisplay}" Command="{Binding ToggleGameStateCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Success}" Padding="4" FontSize="9"/><Button Grid.Column="5" Content="変更を保存" Command="{Binding SaveChangesCommand}" IsEnabled="False" Padding="8,2" FontSize="9"/></Grid></Border>

        <Grid Grid.RowSpan="5" Panel.ZIndex="30" Visibility="{Binding IsDeleteConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}"><Border Background="#B0000000"/><Border Width="390" Padding="24" Background="#2B2831" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Playlistを削除しますか？" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingDeletePlaylist.Label}" Foreground="{StaticResource Brush.Accent}" FontSize="16" Margin="0,10,0,4"/><TextBlock Text="Mockデータのみを変更します。実ゲームファイルには触れません。" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="キャンセル" Command="{Binding CancelDeletePlaylistCommand}"/><Button Content="削除" Command="{Binding ConfirmDeletePlaylistCommand}" Background="#703747" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Grid>

        <Grid Grid.RowSpan="5" Panel.ZIndex="20" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#B0000000"/>
            <Border Width="610" HorizontalAlignment="Right" Background="#25232B" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0" Padding="25">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><TextBlock Text="設定 / Environment" FontSize="24" FontWeight="SemiBold"/><Button Content="✕" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" Width="38"/></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Data Locations / Real Library — Read-only" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="自動検出と手動指定は毎回Validationされます。アクセス不可をデータ削除とは判断しません。" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <Button Content="再検出" Command="{Binding RescanCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding EnvironmentLocations}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#302D38" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusDisplay}" Foreground="{StaticResource Brush.Warning}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding SourceDisplay}" Foreground="{StaticResource Brush.TextMuted}"/></StackPanel></StackPanel>
                                        <Button Grid.Column="1" Content="参照..." Command="{Binding DataContext.BrowseLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5"/>
                                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PathDisplay, Mode=OneWay}" IsReadOnly="True" Margin="0,7,0,5" FontSize="10"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ValidationMessage}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" FontSize="10"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="音量" Style="{StaticResource SectionLabel}"/><Slider Minimum="0" Maximum="100" Value="{Binding Volume}"/><CheckBox Content="ミュート" IsChecked="{Binding IsMuted}" Foreground="{StaticResource Brush.Text}" Margin="0,8,0,0"/>
                            <Border Background="#302B38" CornerRadius="5" Padding="11" Margin="0,18,0,0"><TextBlock Text="Phase 2Bは実Song Libraryを読み取り専用で表示します。Playlist・Favorites・DB・曲ファイルへの書込操作は無効です。環境検出失敗時のみMock Dataへ安全にFallbackします。" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"/></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="閉じる" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right" Margin="0,14,0,0" Background="{StaticResource Brush.AccentDark}" MinWidth="96"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
