<UserControl x:Class="SynthRidersPlaylistManager.App.Views.CollectionBrowserView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:behaviors="clr-namespace:SynthRidersPlaylistManager.App.Behaviors" xmlns:converters="clr-namespace:SynthRidersPlaylistManager.App.Converters" xmlns:controls="clr-namespace:SynthRidersPlaylistManager.App.Controls" MinWidth="500">
 <UserControl.Resources>
  <converters:SelectedCollectionBrushConverter x:Key="SelectedCollectionBrush"/>
  <converters:PaneSongCheckedConverter x:Key="PaneSongChecked"/>
  <converters:PaneRowBackgroundConverter x:Key="PaneRowBackground"/>
  <Style x:Key="BrowserCellStyle" TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Brush.Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="BrowserGrid" TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Extended"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="Background" Value="{StaticResource Brush.Surface}"/><Setter Property="Foreground" Value="{StaticResource Brush.Text}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/><Setter Property="RowBackground" Value="#1E1D23"/><Setter Property="AlternatingRowBackground" Value="#222128"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
   <Style.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#292731"/><Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="9"/></Style><Style TargetType="DataGridCell" BasedOn="{StaticResource BrowserCellStyle}"/><Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="45"/><Setter Property="BorderBrush" Value="#302E37"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource PaneRowBackground}"><Binding RelativeSource="{RelativeSource Self}" Path="IsSelected"/><Binding Path="IsSourceChecked"/><Binding Path="IsDestinationChecked"/><Binding Path="DataContext.Side" RelativeSource="{RelativeSource AncestorType=DataGrid}"/><Binding Path="DataContext.IsActive" RelativeSource="{RelativeSource AncestorType=DataGrid}"/><Binding RelativeSource="{RelativeSource Self}" Path="IsMouseOver"/><Binding RelativeSource="{RelativeSource Self}" Path="AlternationIndex"/></MultiBinding></Setter.Value></Setter></Style></Style.Resources>
   <Style.Triggers><Trigger Property="behaviors:SongDragDropBehavior.IsDragOver" Value="True"><Setter Property="Background" Value="#3B2D4A"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="CollectionItem">
   <Button Command="{Binding DataContext.SelectCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" BorderThickness="0" Padding="7,5" ToolTip="{Binding Label}">
    <Button.Background><MultiBinding Converter="{StaticResource SelectedCollectionBrush}"><Binding/><Binding Path="DataContext.SelectedCollection" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Button.Background>
    <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/>
   </Button>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Background="{StaticResource Brush.Background}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="0.27*" MinWidth="145"/><ColumnDefinition Width="4"/><ColumnDefinition Width="0.73*" MinWidth="350"/></Grid.ColumnDefinitions>

  <!-- Persistent Collection Menu: always visible in both browser instances. -->
  <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,8">
    <TextBlock Text="{Binding PaneLabel}" Foreground="{Binding PaneAccent}" FontSize="10" FontWeight="Bold" Margin="5,0,5,8"/>
    <TextBlock Text="FAVORITES" Style="{StaticResource SectionLabel}"/><ItemsControl ItemsSource="{Binding Owner.FavoritesNavigation}" ItemTemplate="{StaticResource CollectionItem}"/>
    <Grid Margin="0,8,0,2"><TextBlock Text="PLAYLISTS" Style="{StaticResource SectionLabel}"/><TextBlock Text="右クリックで管理" HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" FontSize="8" VerticalAlignment="Center" Margin="0,0,5,0"/></Grid>
    <ItemsControl ItemsSource="{Binding Owner.PlaylistNavigation}"><ItemsControl.ItemTemplate><DataTemplate>
     <Button Command="{Binding DataContext.SelectCollectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" BorderThickness="0" Padding="7,5" ToolTip="{Binding Label}">
      <Button.Background><MultiBinding Converter="{StaticResource SelectedCollectionBrush}"><Binding/><Binding Path="DataContext.SelectedCollection" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Button.Background>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Background="#322A3B" CornerRadius="8" Padding="5,1"><TextBlock Text="{Binding Count}" FontSize="8" Foreground="{StaticResource Brush.TextMuted}"/></Border></Grid>
      <Button.ContextMenu><ContextMenu><MenuItem Header="Browser Aで開く" Command="{Binding OpenAsSourceCommand}"/><MenuItem Header="Browser Bで開く" Command="{Binding SetAsDestinationCommand}"/><Separator/><MenuItem Header="名前変更…" Command="{Binding PrepareRenameCommand}"/><MenuItem Header="複製" Command="{Binding DuplicateCommand}"/><MenuItem Header="削除…" Command="{Binding RequestDeleteCommand}"/></ContextMenu></Button.ContextMenu>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Background="#24222A" CornerRadius="4" Padding="6" Margin="2,6"><StackPanel><TextBox Text="{Binding Owner.PlaylistNameDraft, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" ToolTip="新規名／変更後名称"/><UniformGrid Columns="2" Margin="0,4,0,0"><Button Content="＋ 新規" Command="{Binding Owner.CreatePlaylistCommand}" Padding="3"/><Button Content="名前変更" Command="{Binding Owner.RenamePlaylistCommand}" Padding="3" Margin="3,0,0,0"/></UniformGrid></StackPanel></Border>
    <TextBlock Text="SMART FILTERS" Style="{StaticResource SectionLabel}" Margin="0,8,0,2"/><ItemsControl ItemsSource="{Binding Owner.SmartNavigation}" ItemTemplate="{StaticResource CollectionItem}"/>
   </StackPanel></ScrollViewer>
  </Border>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#34303B" ShowsPreview="True"/>

  <!-- Song browser content. -->
  <Grid Grid.Column="2" Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="{Binding CollectionType}" Foreground="{StaticResource Brush.TextMuted}" FontSize="9"/><TextBlock Text="{Binding CollectionName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"><Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text=" 曲"/></TextBlock></Grid>
   <Grid Grid.Row="1" Margin="0,8,0,7"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="27,7,7,7"/><TextBlock Text="🔍  曲名・Artist・Mapperを検索..." Margin="8,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.TextMuted}" Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/></Grid>
   <Border Grid.Row="2" Background="#352A42" BorderBrush="{StaticResource Brush.AccentDark}" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0,0,0,6" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"><WrapPanel><TextBlock Text="{Binding SelectionDisplay}" FontWeight="SemiBold" Margin="4,5,7,5"/><Button Content="反対側へ追加" Command="{Binding AddToOppositeCommand}"/><Button Content="移動" Command="{Binding MoveToOppositeCommand}"/><Button Content="チェック解除" Command="{Binding ClearSelectionCommand}"/></WrapPanel></Border>
   <Grid Grid.Row="3">
    <DataGrid x:Name="SongsGrid" ItemsSource="{Binding VisibleSongs}" SelectedItem="{Binding Owner.SelectedSong}" Style="{StaticResource BrowserGrid}" PreviewMouseLeftButtonDown="SongsGrid_PreviewMouseLeftButtonDown" GotKeyboardFocus="SongsGrid_GotKeyboardFocus" behaviors:SongDragDropBehavior.EnableDrag="{Binding Owner.IsDragDropEnabled}" behaviors:SongDragDropBehavior.EnableDrop="{Binding Owner.IsDragDropEnabled}" behaviors:SongDragDropBehavior.DropCommand="{Binding DropCommand}">
     <DataGrid.Columns>
      <DataGridTemplateColumn Width="31"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox IsThreeState="True" IsChecked="{Binding DataContext.AreAllVisibleChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" PreviewMouseLeftButtonDown="SongCheckBox_PreviewMouseLeftButtonDown" Command="{Binding DataContext.ToggleCheckedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"><CheckBox.IsChecked><MultiBinding Converter="{StaticResource PaneSongChecked}" Mode="OneWay"><Binding Path="IsSourceChecked"/><Binding Path="IsDestinationChecked"/><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></CheckBox.IsChecked></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="♥" Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding FavoriteGlyph}" FontFamily="Segoe UI Symbol" Foreground="#FF4FA3" FontSize="19" Width="34" Height="34" Padding="0" Opacity="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonDown="FavoriteStar_PreviewMouseLeftButtonDown" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="ToolTip" Value="お気に入りに追加"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="ToolTip" Value="お気に入りから解除"/></DataTrigger><DataTrigger Binding="{Binding DataContext.Owner.IsRealDataMode, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="ToolTip" Value="読み取り専用 — 編集は次のフェーズで有効になります"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:CoverArtView Width="34" Height="34" DecodePixelWidth="48" CoverPath="{Binding CoverImagePath}" ToolTip="{Binding CoverToolTip}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="TRACK" Width="1.7*" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel ToolTip="{Binding Title}"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="{StaticResource Brush.TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="MAPPER" Binding="{Binding MapperDisplay}" Width="0.65*" MinWidth="60"/><DataGridTextColumn Header="TIME" Binding="{Binding DurationDisplay}" Width="50"/>
      <DataGridTextColumn Header="PLAYLISTS" Binding="{Binding PlaylistDisplay}" Width="0.75*" MinWidth="75"><DataGridTextColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource BrowserCellStyle}"><Setter Property="ToolTip" Value="{Binding PlaylistToolTip}"/></Style></DataGridTextColumn.CellStyle></DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
    <Border IsHitTestVisible="False" Background="#D0342342" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2" CornerRadius="5" Visibility="{Binding ElementName=SongsGrid, Path=(behaviors:SongDragDropBehavior.IsDragOver), Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="36" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center"/><TextBlock Text="{Binding ElementName=SongsGrid, Path=(behaviors:SongDragDropBehavior.DragFeedback)}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="通常DragはAdd" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center"/></StackPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
